#############################################
# Rule for linking CXX shared library.

rule CXX_SHARED_LIBRARY_LINKER__planning_context_loader_ptp_Debug
  command = $PRE_LINK && /usr/bin/x86_64-linux-gnu-g++-4.8 -fPIC $LANGUAGE_COMPILE_FLAGS $ARCH_FLAGS $LINK_FLAGS -shared $SONAME_FLAG$SONAME -o $TARGET_FILE $in $LINK_PATH $LINK_LIBRARIES && $POST_BUILD
  description = Linking CXX shared library $TARGET_FILE
  restat = $RESTAT


